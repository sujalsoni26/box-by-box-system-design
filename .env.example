# Copy to .env.local (git ignores it) and fill in. Every variable is optional: without the Firebase ones the
# site runs exactly as before, with progress kept in the browser and no accounts. Setup: docs/accounts.md.
#
# These NEXT_PUBLIC_ values are built into the JavaScript the browser downloads; they identify the Firebase
# project and are not secrets. Never put a service account key or any admin credential here.

# Firebase web app config (Firebase console > Project settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Optional: App Check with reCAPTCHA v3 (the site key, not the secret key)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# Optional, local development only: print an App Check debug token in the browser console
# NEXT_PUBLIC_APPCHECK_DEBUG=true

# Optional: set to "off" to serve Google sign-in from <project>.firebaseapp.com instead of this site's /__/auth
# NEXT_PUBLIC_FIREBASE_AUTH_PROXY=off
